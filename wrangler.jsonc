{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
